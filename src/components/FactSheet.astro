---
/** Fact sheet: role, duration, stack, status (design doc §8.11, FactSheet). Not interactive. */
export interface FactItem {
	label: string;
	value: string;
}

interface Props {
	items: readonly FactItem[];
	/** Desktop columns. Mini-cases use 2, detail pages use 3 (the default). */
	cols?: 2 | 3;
}

const { items, cols = 3 } = Astro.props;
---

<dl class:list={['fact-sheet', { 'fact-sheet--cols-2': cols === 2 }]}>
	{
		items.map((item) => (
			<div class="fact-sheet__item">
				<dt>{item.label}</dt>
				<dd>{item.value}</dd>
			</div>
		))
	}
</dl>

<style>
	.fact-sheet {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-block: var(--space-3);
		border-block: var(--border-width) solid var(--color-border);
		font-family: var(--font-accent);
		font-size: var(--text-xs);
		line-height: var(--leading-normal);
	}

	.fact-sheet__item {
		display: flex;
		gap: var(--space-3);
		min-width: 0;
	}

	.fact-sheet dt {
		flex: none;
		width: var(--fact-label-col);
		color: var(--color-text-muted);
	}

	.fact-sheet dd {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 0;
		color: var(--color-text);
	}

	@media (width >= 48rem) /* --bp-md */ {
		.fact-sheet {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-6) var(--space-8);
			padding-block: var(--space-6);
		}

		.fact-sheet--cols-2 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.fact-sheet__item {
			flex-direction: column;
			gap: var(--space-2);
		}

		.fact-sheet dt {
			width: auto;
			font-size: var(--text-2xs);
			letter-spacing: var(--tracking-caps);
			text-transform: uppercase;
		}

		.fact-sheet dd {
			font-size: var(--text-sm);
		}
	}
</style>
