---
/**
 * A list of full-width link rows: label · path · arrow. Used by the 404 (design/pages/404.md).
 * MISSING IN §8: modeled on the ExperienceList linked row (§8.8). Add it to diseno §8 at close.
 */
import ArrowIcon from './ArrowIcon.astro';

interface Props {
	/** The path column shows the href itself. */
	items: { label: string; href: string }[];
}

const { items } = Astro.props;
---

<ul class="link-rows">
	{
		items.map((item) => (
			<li class="link-rows__item">
				<a class="link-rows__link" href={item.href}>
					<span class="link-rows__label">{item.label}</span>
					<span class="link-rows__path">{item.href}</span>
					<span class="link-rows__arrow" aria-hidden="true">
						<ArrowIcon direction="right" />
					</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.link-rows {
		list-style: none;
		padding: 0;
		border-top: var(--border-width) solid var(--color-border);
	}

	.link-rows__item {
		border-bottom: var(--border-width) solid var(--color-border);
	}

	/* The path takes the middle column so it can wrap at 320px before the label does. */
	.link-rows__link {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: baseline;
		gap: var(--space-4);
		min-height: var(--tap-min);
		padding: var(--space-3);
		color: inherit;
		text-decoration: none;
	}

	.link-rows__label {
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
	}

	.link-rows__path {
		justify-self: end;
		text-align: end;
		font-family: var(--font-accent);
		font-size: var(--text-2xs);
		color: var(--color-text-muted);
		overflow-wrap: anywhere;
	}

	/* Hidden at rest, shown on hover and keyboard focus. No transition (diseno §3). */
	.link-rows__arrow {
		visibility: hidden;
		font-family: var(--font-accent);
		font-size: var(--text-xs);
		color: var(--color-accent);
	}

	.link-rows__link:hover,
	.link-rows__link:focus-visible {
		background: var(--color-surface);
	}

	.link-rows__link:hover .link-rows__arrow,
	.link-rows__link:focus-visible .link-rows__arrow {
		visibility: visible;
	}
</style>
