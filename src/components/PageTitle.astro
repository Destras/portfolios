---
/** Inner-page h1 with an optional lead and an optional default slot after it (design doc §8.7, PageTitle). */
interface Props {
	title: string;
	lead?: string;
}

const { title, lead } = Astro.props;
---

<header class="page-title">
	<h1>{title}</h1>
	{lead && <p class="page-title__lead">{lead}</p>}
	<!-- Optional extra line inside the title block (e.g. the /now update line, design doc §8.13). -->
	<slot />
</header>

<style>
	.page-title {
		margin-bottom: var(--space-10);
	}

	.page-title h1 {
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.page-title__lead {
		margin-top: var(--space-4);
		font-size: var(--text-md);
		color: var(--color-text);
		text-wrap: pretty;
	}
</style>
