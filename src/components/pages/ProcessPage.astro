---
/** Process (/es/proceso/, /en/process/): the "Sobre mí" page (design/pages/process.md). */
import type { Locale } from '../../i18n/locales';
import { getDictionary } from '../../i18n/dictionaries';
import { contactEmail, cvHref } from '../../data/contact';
import ButtonLink from '../ButtonLink.astro';
import SectionTitle from '../SectionTitle.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const p = getDictionary(locale).process;
---

<main id="contenido" class="page">
	<p class="about-eyebrow">{p.eyebrow}</p>
	<h1 class="about-title">{p.title}</h1>
	<p class="about-lead">{p.lead}</p>
	<div class="about-actions">
		<ButtonLink href={`mailto:${contactEmail}`} variant="primary">{p.actions.email}</ButtonLink>
		<ButtonLink href={cvHref} variant="secondary" arrow>{p.actions.cv}</ButtonLink>
	</div>
	<dl class="fact-list">
		{
			p.facts.map((fact) => (
				<div class="fact-list__row">
					<dt>{fact.label}</dt>
					<dd>{fact.value}</dd>
				</div>
			))
		}
	</dl>
	<section class="origin" aria-labelledby="origin">
		<SectionTitle id="origin" text={p.origin.heading} variant="strong" />
		{p.origin.paragraphs.map((paragraph) => <p class="origin__text">{paragraph}</p>)}
	</section>
</main>

<style>
	.about-eyebrow {
		font-family: var(--font-accent);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
	}

	/* Same type as the home Hero h1. */
	.about-title {
		margin-top: var(--space-6);
		font-size: var(--text-xl);
		font-weight: var(--weight-regular);
		line-height: var(--leading-hero);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		text-wrap: pretty;
	}

	.about-lead,
	.origin__text {
		font-size: var(--text-md);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
		text-wrap: pretty;
	}

	.about-lead {
		margin-top: var(--space-6);
	}

	/* Wraps on narrow screens instead of overflowing. */
	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.fact-list {
		margin-top: var(--space-section);
		border-top: var(--border-width) solid var(--color-border);
		font-family: var(--font-accent);
		font-size: var(--text-xs);
		line-height: var(--leading-normal);
	}

	.fact-list__row {
		display: flex;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-bottom: var(--border-width) solid var(--color-border);
	}

	.fact-list dt {
		flex: none;
		width: var(--fact-label-col);
		color: var(--color-text-muted);
	}

	.fact-list dd {
		flex: 1;
		min-width: 0;
		color: var(--color-text);
	}

	@media (width >= 48rem) /* --bp-md */ {
		.fact-list dt {
			width: var(--row-date-col);
		}
	}

	.origin {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin-top: var(--space-section);
	}
</style>
