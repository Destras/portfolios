---
import { getCollection } from 'astro:content';
import WorkList, { type WorkRef } from '../WorkList.astro';
import PageTitle from '../PageTitle.astro';
import SectionTitle from '../SectionTitle.astro';
import { getDictionary } from '../../i18n/dictionaries';
import type { Locale } from '../../i18n/locales';
import type { WorkKind } from '../../i18n/routes';

/**
 * Projects page body (design/pages/projects.md): Proyectos first, then Experiencia.
 * Every entry of each collection, newest first; WorkList links the rows that have a detail page.
 */
interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

/** All entries of a collection as WorkList refs, newest first. ISO months sort correctly as strings. */
async function allRefs(kind: WorkKind): Promise<WorkRef[]> {
	return (await getCollection(kind))
		.sort((a, b) => b.data.startIso.localeCompare(a.data.startIso))
		.map(({ id }) => ({ kind, id }));
}

const projects = await allRefs('projects');
const experiences = await allRefs('experiences');
---

<main id="contenido" class="page">
	<PageTitle title={t.projects.title} />
	<section class="page__section" aria-labelledby="projects-title">
		<SectionTitle id="projects-title" text={t.projects.projectsHeading} />
		<WorkList refs={projects} locale={locale} />
	</section>
	<section class="page__section" aria-labelledby="experience-title">
		<SectionTitle id="experience-title" text={t.projects.experienceHeading} />
		<WorkList refs={experiences} locale={locale} />
	</section>
</main>
