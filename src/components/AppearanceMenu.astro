---
/**
 * Header theme and mode selector (design/themeSelector/Temas-v3-desktop.dc.html).
 * A disclosure button opens a panel with two native radio groups: theme and mode.
 * The pre-paint script in Layout.astro applies the stored values; this component only changes them.
 */
import type { Locale } from '../i18n/locales';
import { getDictionary } from '../i18n/dictionaries';
import { DEFAULT_THEME, THEMES } from '../scripts/appearance';

interface Props {
	locale: Locale;
	class?: string;
}

// `rest` carries the parent's scope attribute (see LangSwitch).
const { locale, class: className, ...rest } = Astro.props;
const t = getDictionary(locale).site.appearance;
const defaultName = THEMES.find((th) => th.id === DEFAULT_THEME)!.name;
const modes = [
	{ id: 'light', name: t.day },
	{ id: 'dark', name: t.night },
] as const;
---

<appearance-menu class:list={['appearance', className]} data-day={t.day} data-night={t.night} {...rest}>
	<button type="button" class="appearance__btn" aria-expanded="false" aria-controls="appearance-panel">
		<span class="appearance__swatch appearance__swatch--current" aria-hidden="true"></span>
		<span class="visually-hidden">{t.label}: </span>
		<!-- Server default; the script replaces it with the active theme and mode on connect. -->
		<span class="appearance__current">{defaultName} · {t.day}</span>
		<span class="appearance__caret" aria-hidden="true">▾</span>
	</button>
	<div id="appearance-panel" class="appearance__panel" hidden>
		<fieldset class="appearance__group" data-group="theme">
			<legend class="appearance__label">{t.theme}</legend>
			{
				THEMES.map((th) => (
					<label class="appearance__item">
						<input class="visually-hidden" type="radio" name="appearance-theme" value={th.id} />
						<span class="appearance__swatch" style={`background: var(--swatch-${th.id})`} aria-hidden="true" />
						<span class="appearance__name">{th.name}</span>
						<span class="appearance__check" aria-hidden="true">
							✓
						</span>
					</label>
				))
			}
		</fieldset>
		<fieldset class="appearance__group" data-group="mode">
			<legend class="appearance__label">{t.mode}</legend>
			<div class="appearance__seg">
				{
					modes.map((m) => (
						<label class="appearance__seg-btn">
							<input class="visually-hidden" type="radio" name="appearance-mode" value={m.id} />
							{m.name}
						</label>
					))
				}
			</div>
		</fieldset>
	</div>
</appearance-menu>

<style>
	.appearance {
		position: relative;
		display: flex;
		align-items: center;
	}

	.appearance__btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: var(--tap-min);
		padding: 0 var(--space-2);
		border: 0;
		border-radius: var(--radius-md);
		background: transparent;
		font: inherit;
		color: var(--color-text);
		cursor: pointer;
	}

	.appearance__btn:hover {
		background: var(--color-surface);
	}

	.appearance__caret {
		color: var(--color-text-muted);
	}

	/* Mobile: swatch and caret only; the label stays in the accessible name. */
	.appearance__current {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (width >= 48rem) /* --bp-md */ {
		.appearance__current {
			position: static;
			width: auto;
			height: auto;
			overflow: visible;
			clip-path: none;
		}
	}

	.appearance__swatch {
		display: inline-block;
		flex: none;
		width: var(--swatch-size);
		height: var(--swatch-size);
		border-radius: var(--radius-full);
		box-shadow: inset 0 0 0 var(--border-width) var(--color-border);
	}

	/* The active theme's accent is the current --color-accent. */
	.appearance__swatch--current {
		background: var(--color-accent);
	}

	.appearance__panel {
		position: absolute;
		top: calc(100% + var(--space-2));
		right: 0;
		z-index: var(--z-popover);
		min-width: var(--popover-min-width);
		padding: var(--space-2);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		box-shadow: var(--shadow-popover);
		font-family: var(--font-accent);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
	}

	.appearance__panel[hidden] {
		display: none;
	}

	.appearance__group {
		min-inline-size: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}

	.appearance__group + .appearance__group {
		margin-top: var(--space-2);
		padding-top: var(--space-2);
		border-top: var(--border-width) solid var(--color-border);
	}

	/* Float takes the legend out of the fieldset border, so the group divider draws as a plain line. */
	.appearance__label {
		float: left;
		width: 100%;
		padding: var(--space-1) var(--space-3) var(--space-2);
		font-size: var(--text-2xs);
		letter-spacing: var(--tracking-caps);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.appearance__item,
	.appearance__seg {
		clear: both;
	}

	.appearance__item {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--tap-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-sm);
		color: var(--color-text);
		cursor: pointer;
	}

	.appearance__item:hover {
		background: var(--color-surface);
	}

	.appearance__name {
		flex: 1;
	}

	.appearance__check {
		visibility: hidden;
	}

	.appearance__item:has(:checked) .appearance__check {
		visibility: visible;
	}

	.appearance__seg {
		display: flex;
		gap: calc(var(--space-1) / 2);
		margin: 0 var(--space-3) var(--space-2);
		padding: calc(var(--space-1) / 2);
		border-radius: var(--radius-full);
		box-shadow: inset 0 0 0 var(--border-width) var(--color-border);
	}

	.appearance__seg-btn {
		display: inline-flex;
		flex: 1;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		min-height: var(--tap-min);
		padding: 0 var(--space-3);
		border-radius: var(--radius-full);
		color: var(--color-text-muted);
		cursor: pointer;
	}

	.appearance__seg-btn:has(:checked) {
		background: var(--color-surface);
		color: var(--color-text);
		box-shadow: inset 0 0 0 var(--border-width) var(--color-border);
	}

	/* The radios are visually hidden: their label carries the focus ring. */
	.appearance__item:has(:focus-visible),
	.appearance__seg-btn:has(:focus-visible) {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: calc(-1 * var(--focus-offset));
	}
</style>

<script>
	import {
		closesOnThemePick,
		effectiveMode,
		parseMode,
		parseTheme,
		shouldAnimate,
		THEMES,
		type Mode,
		type Theme,
	} from '../scripts/appearance';

	function read(key: 'theme' | 'mode'): string | null {
		try {
			return localStorage.getItem(key);
		} catch {
			return null;
		}
	}

	function store(key: 'theme' | 'mode', value: string) {
		try {
			localStorage.setItem(key, value);
		} catch {
			// Storage blocked: the page still changes, the choice just doesn't persist.
		}
	}

	class AppearanceMenu extends HTMLElement {
		#button!: HTMLButtonElement;
		#panel!: HTMLElement;
		#current!: HTMLElement;
		#systemDark = matchMedia('(prefers-color-scheme: dark)');
		/** Set by pointerdown, cleared by keydown: tells a pointer pick from an arrow-key change. */
		#pointer = false;

		connectedCallback() {
			this.#button = this.querySelector('.appearance__btn')!;
			this.#panel = this.querySelector('.appearance__panel')!;
			this.#current = this.querySelector('.appearance__current')!;
			const themeGroup = this.querySelector<HTMLElement>('[data-group="theme"]')!;
			const modeGroup = this.querySelector<HTMLElement>('[data-group="mode"]')!;

			this.#button.addEventListener('click', () => this.#setOpen(!this.#isOpen()));
			themeGroup.addEventListener('change', (event) => {
				this.apply({ theme: parseTheme((event.target as HTMLInputElement).value) });
			});
			// Mode on click, not change: clicking the mode already shown (the system's) must still lock it,
			// and that fires no change. Arrow keys fire click too.
			modeGroup.addEventListener('click', (event) => {
				const mode = parseMode((event.target as HTMLInputElement).value);
				if (mode && mode !== parseMode(read('mode'))) this.apply({ mode });
			});
			themeGroup.addEventListener('pointerdown', () => (this.#pointer = true));
			themeGroup.addEventListener('keydown', () => (this.#pointer = false));
			// Click (not change) so re-picking the checked theme also closes; it fires before change.
			themeGroup.addEventListener('click', (event) => {
				if ((event.target as HTMLElement).matches('input') && closesOnThemePick(this.#pointer)) {
					this.#setOpen(false, true);
				}
			});
			// On document: Safari doesn't focus buttons on click, so after a mouse open the key goes to <body>.
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && this.#isOpen()) this.#setOpen(false, true);
			});
			document.addEventListener('click', (event) => {
				if (!this.contains(event.target as Node)) this.#setOpen(false);
			});
			this.#systemDark.addEventListener('change', () => this.#render());
			// Back/forward cache restores the page as it was; the choice may have changed on another page since.
			window.addEventListener('pageshow', (event) => {
				if (event.persisted) this.#syncFromStorage();
			});

			this.#render();
		}

		/** Writes the choice to <html> and localStorage, then refreshes the control. */
		apply(change: { theme?: Theme; mode?: Mode }) {
			// Store now, not inside the transition callback (it runs a frame later): leaving the page right away keeps the choice.
			if (change.theme) store('theme', change.theme);
			if (change.mode) store('mode', change.mode);
			const update = () => {
				const root = document.documentElement;
				if (change.theme) root.dataset.theme = change.theme;
				if (change.mode) root.dataset.mode = change.mode;
				this.#render();
			};
			// Cross-fade the whole page (base.css sets the timing); instant without the API or with reduced motion.
			const animate = shouldAnimate({
				hasViewTransitions: 'startViewTransition' in document,
				reducedMotion: matchMedia('(prefers-reduced-motion: reduce)').matches,
			});
			if (animate) document.startViewTransition(update);
			else update();
		}

		/** Same rules as the pre-paint script in Layout.astro: valid stored values win, the rest is default/system. */
		#syncFromStorage() {
			const root = document.documentElement;
			root.dataset.theme = parseTheme(read('theme'));
			const mode = parseMode(read('mode'));
			if (mode) root.dataset.mode = mode;
			else delete root.dataset.mode;
			this.#setOpen(false);
			this.#render();
		}

		#isOpen() {
			return this.#button.getAttribute('aria-expanded') === 'true';
		}

		#setOpen(open: boolean, returnFocus = false) {
			this.#panel.hidden = !open;
			this.#button.setAttribute('aria-expanded', String(open));
			if (!open && returnFocus) this.#button.focus();
		}

		#render() {
			const root = document.documentElement;
			const theme = parseTheme(root.dataset.theme);
			const mode = effectiveMode(parseMode(root.dataset.mode), this.#systemDark.matches);
			for (const input of this.querySelectorAll<HTMLInputElement>('input[type="radio"]')) {
				input.checked = input.value === (input.name === 'appearance-theme' ? theme : mode);
			}
			const name = THEMES.find((t) => t.id === theme)!.name;
			const modeName = mode === 'dark' ? this.dataset.night : this.dataset.day;
			this.#current.textContent = `${name} · ${modeName}`;
		}
	}

	customElements.define('appearance-menu', AppearanceMenu);
</script>
