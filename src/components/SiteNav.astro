---
import type { Locale } from '../i18n/locales';
import { getDictionary } from '../i18n/dictionaries';
import { localizedPath, type RouteKey } from '../i18n/routes';

interface Props {
	locale: Locale;
	routeKey: RouteKey;
	/** "page" on the section itself, "true" on one of its subpages (a work detail). */
	navCurrent: 'page' | 'true';
	class?: string;
}

// `rest` carries the parent's scope attribute so SiteHeader can place this nav in its grid.
const { locale, routeKey, navCurrent, class: className, ...rest } = Astro.props;
const t = getDictionary(locale).site;

// "Casos de estudio" joins later, once its pages exist.
const items = [
	{ key: 'process', label: t.nav.process },
	{ key: 'projects', label: t.nav.projects },
] as const;
---

<nav class:list={['site-nav', className]} aria-label={t.navLabel} {...rest}>
	{
		items.map((item, i) => (
			<>
				{i > 0 && (
					<span class="site-nav__sep" aria-hidden="true">
						·
					</span>
				)}
				<a
					class="site-nav__link"
					href={localizedPath(item.key, locale)}
					aria-current={item.key === routeKey ? navCurrent : undefined}
				>
					{item.label}
				</a>
			</>
		))
	}
</nav>

<style>
	.site-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		column-gap: var(--space-2);
		min-height: var(--tap-min);
	}

	.site-nav__link {
		position: relative;
		display: flex;
		align-items: center;
		min-height: var(--tap-min);
		color: var(--color-text);
		text-decoration: none;
	}

	.site-nav__link:hover,
	.site-nav__link[aria-current] {
		color: var(--color-accent);
	}

	.site-nav__link[aria-current]:hover {
		color: var(--color-accent-hover);
	}

	/* Current page or section: a dot under the label. */
	.site-nav__link[aria-current]::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: var(--space-1);
		width: var(--dot-size);
		height: var(--dot-size);
		margin-left: calc(var(--dot-size) / -2);
		border-radius: 50%;
		background: currentColor;
	}

	.site-nav__sep {
		color: var(--color-text-muted);
	}
</style>
