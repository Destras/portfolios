---
import { Font } from 'astro:assets';
import '../styles/themes/salvia.css';
import '../styles/themes/brasa.css';
import '../styles/modes.css';
import '../styles/foundations.css';
import '../styles/base.css';
import '../styles/layout.css';
import { defaultLocale, getAlternateLinks, isLocale } from '../i18n/locales';

interface Props {
	title: string;
	description?: string;
}

const { title, description } = Astro.props;
// The language comes from the URL prefix, never from a prop, so it can't disagree with the route.
const lang = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const alternates = getAlternateLinks(Astro.url.pathname, Astro.site!);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" preload />
		<!-- Applies the stored theme and mode before first paint. Read-only: never writes to localStorage. -->
		<script is:inline>
			try {
				const root = document.documentElement;
				const theme = localStorage.getItem('theme');
				const mode = localStorage.getItem('mode');
				if (['salvia', 'brasa'].includes(theme)) root.dataset.theme = theme;
				if (['light', 'dark'].includes(mode)) root.dataset.mode = mode;
			} catch {}
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
	</head>
	<body>
		<slot />
	</body>
</html>
