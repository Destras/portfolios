---
import { Font } from 'astro:assets';
import { themeBootstrap } from '../scripts/themeBootstrap';
import '../styles/themes/salvia.css';
import '../styles/themes/brasa.css';
import '../styles/modes.css';
import '../styles/foundations.css';
import '../styles/base.css';
import '../styles/layout.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SkipLink from '../components/SkipLink.astro';
import { defaultLocale, isLocale, locales, type Locale } from '../i18n/locales';
import { serializeJsonLd } from '../lib/structured-data';
import { alternates, sectionPaths, type LocalePaths, type RouteKey } from '../i18n/routes';

interface Props {
	title: string;
	description?: string;
	/** Which section this page belongs to, in route-map terms. Drives the nav state. */
	routeKey: RouteKey;
	/**
	 * This page's path in every locale (canonical, hreflang, language switch). Defaults to the section's own paths.
	 * Passing it marks the page as a subpage of `routeKey` (a work detail): the nav marks it `aria-current="true"`.
	 */
	paths?: LocalePaths;
	/** Keeps placeholder pages out of search results until they have content. */
	noindex?: boolean;
	/** Open Graph type: `profile` on the home page, `article` on work details, `website` elsewhere. */
	ogType?: 'website' | 'profile' | 'article';
	/** schema.org data for this page (src/lib/structured-data.ts), rendered as JSON-LD in <head>. */
	jsonLd?: object;
}

const { title, description, routeKey, paths: subpagePaths, noindex = false, ogType = 'website', jsonLd } = Astro.props;
const paths = subpagePaths ?? sectionPaths(routeKey);
// The language comes from the URL prefix, never from a prop, so it can't disagree with the route.
const lang = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const canonical = new URL(paths[lang], Astro.site).href;
// Crawlers need an absolute URL for og:image.
const ogImage = new URL('/og.png', Astro.site).href;
const ogLocales: Record<Locale, string> = { es: 'es_AR', en: 'en_US' };
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" preload />
		<!-- Applies the stored theme and mode before first paint (src/scripts/themeBootstrap.ts). -->
		<script is:inline set:html={themeBootstrap} />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="canonical" href={canonical} />
		{alternates(paths, Astro.site!).map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
		<!-- Link previews (Open Graph + X). One language-neutral image for every page: social crawlers don't render SVG, so it's a PNG. -->
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content="Juan Ignacio Werkalec" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocales[lang]} />
		{locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Juan Ignacio Werkalec" />
		<meta name="twitter:card" content="summary_large_image" />
		{jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
	</head>
	<body>
		<SkipLink locale={lang} />
		<SiteHeader locale={lang} routeKey={routeKey} paths={paths} navCurrent={subpagePaths ? 'true' : 'page'} />
		<!-- Each page renders its own <main id="contenido" class="page">. -->
		<slot />
		<div class="site-footer-wrap">
			<SiteFooter locale={lang} />
		</div>
	</body>
</html>
