---
import { defaultLocale } from '../i18n/locales';
import { localizedPath } from '../i18n/routes';

// Static build: Astro emits a meta-refresh page to /es/. On Cloudflare, src/worker.ts answers / before the assets
// (307 by Accept-Language), so this page is only the fallback for `astro preview` and other hosts.
// 301: the static meta refresh then fires with no delay (Astro uses a 2 s delay for 302).
return Astro.redirect(localizedPath('home', defaultLocale), 301);
---
