---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PlaceholderPage from '../../components/pages/PlaceholderPage.astro';
import { isPageKey, sectionPages } from '../../components/pages/sectionPages';
import { getDictionary } from '../../i18n/dictionaries';
import { locales } from '../../i18n/locales';
import { routes, sectionKeys } from '../../i18n/routes';

// One route per (section × locale), straight from the route map: /es/proyectos/, /en/projects/, …
// Each route gets its internal key as a prop, so the page never parses the slug.
export const getStaticPaths = (() =>
	sectionKeys.flatMap((key) =>
		locales.map((locale) => ({
			params: { locale, section: routes[key][locale] },
			props: { key, locale },
		})),
	)) satisfies GetStaticPaths;

const { key, locale } = Astro.props;
const t = getDictionary(locale);

// A section with a page in `sectionPages` renders it with its own meta; any other one is a noindex placeholder.
// `Page` is capitalized because Astro only renders a dynamic tag from a capitalized variable.
const { Page, meta, placeholderTitle } = isPageKey(key)
	? { Page: sectionPages[key], meta: t[key].meta, placeholderTitle: null }
	: {
			Page: null,
			meta: { title: `${t.pages[key].title} · Juan Ignacio Werkalec`, description: t.pages[key].description },
			placeholderTitle: t.pages[key].title,
		};
---

<Layout title={meta.title} description={meta.description} routeKey={key} noindex={!Page}>
	{Page ? <Page locale={locale} /> : <PlaceholderPage title={placeholderTitle} />}
</Layout>
