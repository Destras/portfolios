---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PlaceholderPage from '../../components/pages/PlaceholderPage.astro';
import StyleguidePage from '../../components/pages/StyleguidePage.astro';
import ColophonPage from '../../components/pages/ColophonPage.astro';
import UsesPage from '../../components/pages/UsesPage.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { locales } from '../../i18n/locales';
import { routes, sectionKeys } from '../../i18n/routes';

// One route per (section × locale), straight from the route map: /es/proyectos/, /en/projects/, …
// Each route gets its internal key as a prop, so the page never parses the slug.
export const getStaticPaths = (() =>
	sectionKeys.flatMap((key) =>
		locales.map((locale) => ({
			params: { locale, section: routes[key][locale] },
			props: { key, locale },
		})),
	)) satisfies GetStaticPaths;

const { key, locale } = Astro.props;
const t = getDictionary(locale);
---

{
	key === 'styleguide' ? (
		<Layout title={t.styleguide.meta.title} description={t.styleguide.meta.description} routeKey={key}>
			<StyleguidePage locale={locale} />
		</Layout>
	) : key === 'uses' ? (
		<Layout title={t.uses.meta.title} description={t.uses.meta.description} routeKey={key}>
			<UsesPage locale={locale} />
		</Layout>
	) : key === 'colophon' ? (
		<Layout title={t.colophon.meta.title} description={t.colophon.meta.description} routeKey={key}>
			<ColophonPage locale={locale} />
		</Layout>
	) : (
		<Layout title={`${t.pages[key].title} · Juan Ignacio Werkalec`} description={t.pages[key].description} routeKey={key} noindex>
			<PlaceholderPage title={t.pages[key].title} />
		</Layout>
	)
}
