---
/** Home (/es/, /en/): the "Sobre mí" design (design/pages/home.md). */
import Layout from '../../layouts/Layout.astro';
import WorkList from '../../components/WorkList.astro';
import ButtonLink from '../../components/ButtonLink.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { localeStaticPaths } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { contactEmail, cvHref, knowsAbout, socialProfiles } from '../../data/contact';
import { profilePageJsonLd } from '../../lib/structured-data';
import { featuredRefs } from '../../data/home';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getDictionary(locale);
const jsonLd = profilePageJsonLd({
	url: new URL(localizedPath('home', locale), Astro.site).href,
	name: 'Juan Ignacio Werkalec',
	jobTitle: 'Senior Full-Stack Engineer',
	image: new URL('/og.png', Astro.site).href,
	sameAs: socialProfiles.map((p) => p.href),
	knowsAbout,
	locale,
});
---

<Layout title={t.home.meta.title} description={t.home.meta.description} routeKey="home" ogType="profile" jsonLd={jsonLd}>
	<main id="contenido" class="page">
		<p class="about-eyebrow">{t.home.eyebrow}</p>
		<h1 class="about-title">{t.home.title}</h1>
		<p class="about-lead">{t.home.lead}</p>
		<p class="about-availability">{t.home.availability}</p>
		<div class="about-actions">
			<ButtonLink href={`mailto:${contactEmail}`} variant="primary">{t.home.actions.email}</ButtonLink>
			<ButtonLink href={cvHref} variant="secondary" arrow>{t.home.actions.cv}</ButtonLink>
		</div>
		<dl class="fact-list">
			{
				t.home.facts.map((fact) => (
					<div class="fact-list__row">
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))
			}
		</dl>
		<section class="work" aria-labelledby="work-title">
			<SectionTitle
				id="work-title"
				text={t.home.work.heading}
				link={{ href: localizedPath('projects', locale), label: t.home.work.allLink }}
			/>
			<WorkList refs={featuredRefs(t)} locale={locale} />
		</section>
	</main>
</Layout>

<style>
	.about-eyebrow {
		font-family: var(--font-accent);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
	}

	.about-title {
		margin-top: var(--space-6);
		font-size: var(--text-xl);
		font-weight: var(--weight-regular);
		line-height: var(--leading-hero);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		text-wrap: pretty;
	}

	.about-lead {
		font-size: var(--text-md);
		line-height: var(--leading-relaxed);
		color: var(--color-text);
		text-wrap: pretty;
	}

	.about-lead {
		margin-top: var(--space-6);
	}

	/* Wraps on narrow screens instead of overflowing. */
	.about-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-8);
	}

	.about-availability {
		margin-top: var(--space-4);
		font-family: var(--font-accent);
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
	}

	.fact-list {
		margin-top: var(--space-section);
		border-top: var(--border-width) solid var(--color-border);
		font-family: var(--font-accent);
		font-size: var(--text-xs);
		line-height: var(--leading-normal);
	}

	.fact-list__row {
		display: flex;
		gap: var(--space-4);
		padding-block: var(--space-4);
		border-bottom: var(--border-width) solid var(--color-border);
	}

	.fact-list dt {
		flex: none;
		width: var(--fact-label-col);
		color: var(--color-text-muted);
	}

	.fact-list dd {
		flex: 1;
		min-width: 0;
		color: var(--color-text);
	}

	@media (width >= 48rem) /* --bp-md */ {
		.fact-list dt {
			width: var(--row-date-col);
		}
	}

	.work {
		margin-top: var(--space-section);
	}
</style>
