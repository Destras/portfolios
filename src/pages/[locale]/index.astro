---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import ExperienceList from '../../components/ExperienceList.astro';
import { getDictionary } from '../../i18n/dictionaries';
import { localeStaticPaths } from '../../i18n/locales';
import { localizedPath } from '../../i18n/routes';
import { featuredWork } from '../../data/home';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getDictionary(locale);

const work = featuredWork(t);
---

<Layout title={t.home.meta.title} description={t.home.meta.description} routeKey="home">
	<main id="contenido" class="page">
		<Hero title={t.home.hero.title} />
		<section class="page__section" aria-labelledby="work-title">
			<SectionTitle
				id="work-title"
				text={t.home.work.heading}
				link={{ href: localizedPath('projects', locale), label: t.home.work.allLink }}
			/>
			<ExperienceList items={work} />
		</section>
	</main>
</Layout>
