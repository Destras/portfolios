---
import Layout from '../../layouts/Layout.astro';
import { localeStaticPaths } from '../../i18n/locales';

export const getStaticPaths = localeStaticPaths;

// Token data mirrors src/styles/themes/*.css and src/styles/foundations.css.
// Values are shown as text; every swatch and sample renders the live token.

const colors = [
	{ name: '--color-bg', use: 'Fondo de la página' },
	{ name: '--color-surface', use: 'Superficies (hover de filas, más adelante)' },
	{ name: '--color-border', use: 'Líneas del header, footer, ficha y tablas' },
	{ name: '--color-text', use: 'Texto principal' },
	{ name: '--color-text-muted', use: 'Fechas, roles, metadatos, footer, separadores' },
	{ name: '--color-accent', use: 'Links, ítem actual del nav, CTA. Solo lo que se puede tocar' },
	{ name: '--color-accent-hover', use: 'Hover de todo lo que usa el acento' },
	{ name: '--color-focus', use: 'Anillo de foco (igual al acento)' },
	{ name: '--color-selection', use: 'Fondo del texto seleccionado (acento al 30 %)' },
	{ name: '--color-on-selection', use: 'Texto seleccionado' },
];

const contrast = [
	{ theme: 'Salvia', rows: [
		['text / bg', '4.5:1', '17.2:1', '16.7:1'],
		['text-muted / bg', '4.5:1', '5.8:1', '7.6:1'],
		['text / surface', '4.5:1', '18.6:1', '15.4:1'],
		['accent / bg', '4.5:1', '7.3:1', '11.7:1'],
		['accent-hover / bg', '4.5:1', '10.6:1', '14.2:1'],
		['focus / bg', '3:1', '7.3:1', '11.7:1'],
	] },
	{ theme: 'Brasa', rows: [
		['text / bg', '4.5:1', '16.3:1', '15.1:1'],
		['text-muted / bg', '4.5:1', '5.9:1', '7.6:1'],
		['text / surface', '4.5:1', '15.1:1', '14.3:1'],
		['accent / bg', '4.5:1', '5.1:1', '5.9:1'],
		['accent-hover / bg', '4.5:1', '7.4:1', '7.6:1'],
		['focus / bg', '3:1', '5.1:1', '5.9:1'],
	] },
];

const families = [
	{ name: 'Atkinson Hyperlegible Next', token: '--font-body', weights: [
		{ token: '--weight-regular', label: '400' },
		{ token: '--weight-semibold', label: '600' },
		{ token: '--weight-bold', label: '700' },
	] },
	{ name: 'Commit Mono', token: '--font-accent', weights: [
		{ token: '--weight-regular', label: '400' },
		{ token: '--weight-bold', label: '700' },
	] },
];

const textSizes = [
	{ name: '--text-2xs', value: '0.75rem', use: 'Etiquetas en mayúsculas' },
	{ name: '--text-xs', value: '0.8125rem', use: 'Mono: fechas, metadatos, ficha' },
	{ name: '--text-sm', value: '0.875rem', use: 'Footer, valores de la ficha' },
	{ name: '--text-nav', value: 'clamp(0.875rem, 0.8530rem + 0.0939vw, 0.9375rem)', use: 'Header' },
	{ name: '--text-base', value: '0.9375rem', use: 'Filas, tablas' },
	{ name: '--text-md', value: 'clamp(1rem, 0.9780rem + 0.0939vw, 1.0625rem)', use: 'Texto de lectura' },
	{ name: '--text-lg', value: 'clamp(1.5rem, 1.4120rem + 0.3756vw, 1.75rem)', use: 'h1 de las páginas internas' },
	{ name: '--text-xl', value: 'clamp(1.5rem, 1.3239rem + 0.7512vw, 2rem)', use: 'h1 del inicio' },
];

const typeTokens = [
	['--leading-tight', '1.3'],
	['--leading-hero', '1.35'],
	['--leading-normal', '1.5'],
	['--leading-relaxed', '1.6'],
	['--tracking-tight', '-0.01em'],
	['--tracking-caps', '0.05em'],
];

const spaces = [
	['--space-1', '0.25rem'],
	['--space-2', '0.5rem'],
	['--space-3', '0.75rem'],
	['--space-4', '1rem'],
	['--space-5', '1.25rem'],
	['--space-6', '1.5rem'],
	['--space-7', '1.75rem'],
	['--space-8', '2rem'],
	['--space-10', '2.5rem'],
	['--space-page-top', 'clamp(2.5rem, 1.2676rem + 5.2582vw, 6rem)'],
	['--space-section', 'clamp(3rem, 2.6479rem + 1.5023vw, 4rem)'],
	['--space-footer-top', 'clamp(5rem, 4.1197rem + 3.7559vw, 7.5rem)'],
	['--space-footer-bottom', 'clamp(2.5rem, 2.1479rem + 1.5023vw, 3.5rem)'],
	['--gutter', 'clamp(1.25rem, 0.6338rem + 2.6291vw, 3rem)'],
];

const radii = [
	['--radius-sm', '4px'],
	['--radius-md', '6px'],
];

const layoutTokens = [
	['--measure', '69ch', 'Ancho de la columna de lectura (esta página)'],
	['--header-height', '4.5rem', 'Alto mínimo del header en desktop'],
	['--tap-min', '2.75rem', 'Área táctil mínima'],
	['--row-date-col', '9.75rem', 'Columna de fecha de la experiencia'],
	['--fact-label-col', '6.75rem', 'Etiqueta de la ficha en mobile'],
	['--table-cat-col', '6.875rem', 'Primera columna de las tablas'],
	['--table-item-col', '15rem', 'Segunda columna de las tablas'],
	['--border-width', '1px', 'Todas las líneas'],
	['--focus-width', '2px', 'Grosor del anillo de foco'],
	['--focus-offset', '2px', 'Separación del anillo'],
	['--underline-offset', '0.25em', 'Separación de los subrayados'],
	['--dot-size', '4px', 'Punto del ítem actual del nav'],
];
---

<Layout
	title="Styleguide · Juan Ignacio Werkalec"
	description="Los tokens y estilos base de juaniw.com."
>
	<main id="contenido" class="page">
		<header class="page__section sg-intro">
			<h1>Styleguide</h1>
			<p>
				Los tokens y los estilos base de este sitio: colores, tipografía, espaciado y los elementos de
				HTML sin clases. Todo lo que se ve acá usa el tema y el modo activos. El modo sigue al de tu
				sistema: si lo cambiás, la página cambia con él.
			</p>
		</header>

		<section class="page__section sg-section" aria-labelledby="color">
			<h2 id="color">Color</h2>
			<p>El acento es solo para lo que se puede tocar. Si lo sacás, la página se entiende igual.</p>
			<ul class="sg-list">
				{colors.map((c) => (
					<li class="sg-row">
						<span class="sg-swatch" style={`background: var(${c.name})`} />
						<div class="sg-meta">
							<code>{c.name}</code>
							<span class="sg-use">{c.use}</span>
						</div>
					</li>
				))}
			</ul>

			<h3>Contraste (WCAG 2.2 AA)</h3>
			{contrast.map((t) => (
				<div class="sg-table-wrap">
				<table class="sg-table">
					<caption>{t.theme}</caption>
					<thead>
						<tr>
							<th scope="col">Par</th>
							<th scope="col">Mínimo</th>
							<th scope="col">Claro</th>
							<th scope="col">Oscuro</th>
						</tr>
					</thead>
					<tbody>
						{t.rows.map((r) => (
							<tr>
								{r.map((cell) => <td>{cell}</td>)}
							</tr>
						))}
					</tbody>
				</table>
				</div>
			))}
		</section>

		<section class="page__section sg-section" aria-labelledby="tipografia">
			<h2 id="tipografia">Tipografía</h2>
			<p>Atkinson Hyperlegible Next para leer; Commit Mono como acento técnico.</p>
			{families.map((f) => (
				<div class="sg-family">
					<p class="sg-label"><code>{f.token}</code> · {f.name}</p>
					{f.weights.map((w) => (
						<p style={`font-family: var(${f.token}); font-weight: var(${w.token})`}>
							{w.label} · Me gusta crear cosas.
						</p>
					))}
				</div>
			))}
			<p class="sg-mono-sample">Ver proyectos <span aria-hidden="true">→</span></p>

			<h3>Escala</h3>
			<ul class="sg-list">
				{textSizes.map((t) => (
					<li class="sg-stack">
						<p style={`font-size: var(${t.name})`}>Tomo features ambiguas con mínimo hand holding.</p>
						<p class="sg-label"><code>{t.name}</code> · <code>{t.value}</code> · {t.use}</p>
					</li>
				))}
			</ul>

			<h3>Interlineado y tracking</h3>
			<ul class="sg-list">
				{typeTokens.map(([name, value]) => (
					<li class="sg-label"><code>{name}</code> · <code>{value}</code></li>
				))}
			</ul>
		</section>

		<section class="page__section sg-section" aria-labelledby="espaciado">
			<h2 id="espaciado">Espaciado</h2>
			<p>Escala de 4 px. Los últimos tokens son fluidos: crecen con el ancho de la pantalla.</p>
			<ul class="sg-list">
				{spaces.map(([name, value]) => (
					<li class="sg-stack">
						<span class="sg-bar" style={`inline-size: var(${name})`} />
						<p class="sg-label"><code>{name}</code> · <code>{value}</code></p>
					</li>
				))}
			</ul>
		</section>

		<section class="page__section sg-section" aria-labelledby="elementos">
			<h2 id="elementos">Elementos</h2>
			<p>
				HTML sin clases, con los estilos base. El h1 es el título de esta página: hay uno solo por
				página. Probá seleccionar texto y recorrer los links con Tab.
			</p>
			<div class="sg-sample">
				<h2>Título de sección (h2)</h2>
				<h3>Configs y AI Configs (h3)</h3>
				<p>
					<strong>Problema:</strong> los clientes no podían cambiar la configuración de sus agentes de IA
					en tiempo real sin hacer un nuevo deploy. Los links van <a href="#elementos">siempre subrayados</a>{' '}
					y cambian de tono con el hover.
				</p>
				<ul>
					<li>Las listas no llevan viñetas.</li>
					<li>Cada componente decide su propio espaciado.</li>
				</ul>
				<table class="sg-table">
					<caption>Herramientas que uso</caption>
					<thead>
						<tr>
							<th scope="col">Categoría</th>
							<th scope="col">Ítem</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Editor</td>
							<td>VS Code</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="page__section sg-section" aria-labelledby="forma">
			<h2 id="forma">Forma y layout</h2>
			<ul class="sg-list">
				{radii.map(([name, value]) => (
					<li class="sg-row">
						<span class="sg-swatch sg-swatch--outline" style={`border-radius: var(${name})`} />
						<p class="sg-label"><code>{name}</code> · <code>{value}</code></p>
					</li>
				))}
				<li class="sg-row">
					<a class="sg-focus-demo" href="#forma">Foco</a>
					<p class="sg-label">Anillo de foco, siempre visible (<code>--focus-width</code>, <code>--focus-offset</code>)</p>
				</li>
			</ul>
			<ul class="sg-list">
				{layoutTokens.map(([name, value, use]) => (
					<li class="sg-label"><code>{name}</code> · <code>{value}</code> · {use}</li>
				))}
			</ul>
		</section>
	</main>
</Layout>

<style>
	.sg-intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.sg-section {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.sg-section h3 {
		margin-top: var(--space-6);
	}

	.sg-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.sg-row {
		display: flex;
		align-items: center;
		gap: var(--space-4);
	}

	.sg-stack {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.sg-swatch {
		flex: none;
		inline-size: var(--tap-min);
		block-size: var(--tap-min);
		border: var(--border-width) solid var(--color-border);
		border-radius: var(--radius-sm);
	}

	.sg-swatch--outline {
		border-color: var(--color-text-muted);
	}

	.sg-meta {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.sg-use {
		font-size: var(--text-sm);
		line-height: var(--leading-normal);
		color: var(--color-text-muted);
	}

	code,
	.sg-label {
		font-family: var(--font-accent);
		font-size: var(--text-xs);
		line-height: var(--leading-normal);
		overflow-wrap: anywhere;
	}

	.sg-label {
		color: var(--color-text-muted);
	}

	.sg-family {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	/* Plain text, not a link: the accent is reserved for interactive elements. */
	.sg-mono-sample {
		font-family: var(--font-accent);
	}

	.sg-bar {
		display: block;
		block-size: var(--space-2);
		background: var(--color-text-muted);
	}

	.sg-sample {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		padding-block: var(--space-6);
		border-block: var(--border-width) solid var(--color-border);
	}

	/* At 320px with a large user font size, only the table scrolls, not the page. */
	.sg-table-wrap {
		overflow-x: auto;
	}

	.sg-table {
		width: 100%;
		font-size: var(--text-base);
		line-height: var(--leading-normal);
	}

	.sg-table caption {
		padding-bottom: var(--space-2);
		font-weight: var(--weight-semibold);
		text-align: left;
	}

	.sg-table th {
		padding-bottom: var(--space-2);
		border-bottom: var(--border-width) solid var(--color-border);
		font-family: var(--font-accent);
		font-size: var(--text-2xs);
		font-weight: var(--weight-regular);
		letter-spacing: var(--tracking-caps);
		text-align: left;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.sg-table td {
		padding-block: var(--space-2);
		border-bottom: var(--border-width) solid var(--color-border);
	}

	.sg-table th + th,
	.sg-table td + td {
		padding-left: var(--space-3);
	}

	/* Always shows the focus ring, so it can be seen without a keyboard. */
	.sg-focus-demo {
		outline: var(--focus-width) solid var(--color-focus);
		outline-offset: var(--focus-offset);
	}
</style>
